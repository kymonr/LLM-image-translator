[Translator]
api_key = sk-ldmootlqntqalzprsinlrhxxfnecniscswnkdgickusyidri
api_base = https://api.siliconflow.cn
model_name = Qwen/Qwen2.5-VL-32B-Instruct
; 模型提示词（像素坐标模式）
model_prompt = 你是一个专业OCR引擎。严格按以下要求处理图像：1. 识别图中所有英文文字并翻译成中文输出2. 为每个文字区域输出检测框坐标3. 输出格式：每行一个JSON对象{"text": "译文", "box": [x_min, y_min, x_max, y_max]}请仔细识别图片中的外语，准确翻译并提供精确的边界框像素化坐标。只许回复json对象，不要注释
; 模型提示词（归一化坐标模式）
model_prompt_normalized = 你是一个专业OCR引擎。严格按以下要求处理图像：1. 识别图中所有英文文字并翻译成中文输出2. 为每个文字区域输出检测框坐标（使用归一化坐标，范围0-1）3. 输出格式：每行一个JSON对象{"text": "译文", "box": [x_min, y_min, x_max, y_max]}请仔细识别图片中的外语，准确翻译并提供归一化坐标（0-1范围）。只许回复json对象，不要注释

[Image]
# 译文背景的透明度 (0-255, 0为全透明, 255为不透明)
text_box_transparency = 180
# 背景色取样后，对其进行的颜色调整强度（数值越大，与原背景色差异越大）
background_discoloration_strength = 40
# 从文本框边缘向外扩展多少像素来取样背景色
background_sample_margin = 10
# 绘制译文所用的字体文件路径
font_path = font/font.ttf
# 是否使用归一化坐标模式 (True/False)
# 启用后，将强制使用归一化坐标(0-1范围)处理文本位置
# 适用于某些压缩图片分辨率的API供应商
normalize_coordinates = False